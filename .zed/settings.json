{
  // Zed places breakpoints on any line already -- there is no equivalent of
  // VS Code's "debug.allowBreakpointsEverywhere", so nothing to set here.

  // Keep the hand-written column alignment in the .asm sources intact.
  "languages": {
    "Assembly": {
      "hard_tabs": false,
      "tab_size": 4,
      "remove_trailing_whitespace_on_save": false,
      "format_on_save": "off"
    }
  },

  "file_types": {
    "Assembly": ["asm", "inc", "s", "S"]
  }
}
